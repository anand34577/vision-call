# Vision Call settings.
#
# Nothing here is required. Vision Call runs with sensible defaults, so only
# uncomment a line when you want to change something. Copy this file to .env
# next to the binary (or next to docker-compose.yml) and restart after editing.
#
# Where a setting comes from, highest priority first:
#   1. A real environment variable (shell, systemd, Docker)
#   2. This .env file
#   3. The admin Settings screen inside the app
#   4. The built-in default
# Anything set in 1 or 2 shows a lock icon on the Settings screen and can
# only be changed here. Most settings are easier to manage from the Settings
# screen, so leave them commented out unless you need them pinned.

# -----------------------------------------------------------------------------
# First admin account (only used when the database is empty)
# -----------------------------------------------------------------------------

# Username of the first admin account. Default: admin
# BOOTSTRAP_ADMIN_USER=admin

# Password for that account. Leave unset and a random one is printed in the
# logs on first start.
# BOOTSTRAP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Network ports (restart needed)
# -----------------------------------------------------------------------------

# HTTPS port for the web app. Camera and microphone need HTTPS in browsers.
# LISTEN_ADDR=:8443

# Plain HTTP port. Serves the app too, which is handy for the Android app.
# HTTP_ADDR=:8080

# One UDP port that carries all group-call audio and video. Open it in your
# firewall. Set to 0 to use random ports instead. Default: 7882
# WEBRTC_UDP_PORT=7882

# The IP address group-call media is sent to. Leave unset: Vision Call uses
# whichever address each browser connected to, which works on a LAN, over a
# VPN and inside Docker. Only set it when that address can't carry UDP, for
# example when a reverse proxy on another machine sits in front of the app.
# EXTERNAL_IP=192.168.1.50

# -----------------------------------------------------------------------------
# HTTPS certificate (restart needed)
# -----------------------------------------------------------------------------
# By default a self-signed certificate is created automatically. Browsers
# show a warning the first time; click through it or install the certificate
# from https://<server>:8443/api/cert to get rid of it.

# Use your own certificate instead.
# TLS_CERT=/path/to/server.crt
# TLS_KEY=/path/to/server.key

# Serve plain HTTP only, with no certificate. Calls then only work from
# the Android app or from a browser on the server itself.
# DISABLE_TLS=true

# Make the HTTP port redirect to HTTPS instead of serving the app.
# HTTPS_REDIRECT=true

# Running behind nginx, Caddy or Traefik? Set TRUST_PROXY so the app reads
# X-Forwarded-* headers, and PROXY_TLS when the proxy always serves HTTPS.
# TRUST_PROXY=true
# PROXY_TLS=true

# -----------------------------------------------------------------------------
# Storage and database (restart needed)
# -----------------------------------------------------------------------------

# Where the database, uploaded files and certificate live. Default: ./data
# (/data in the Docker image).
# DATA_DIR=./data

# Use Postgres or MySQL instead of the built-in SQLite database.
# DATABASE_URL=postgres://user:pass@host:5432/visioncall?sslmode=disable
# DATABASE_URL=mysql://user:pass@host:3306/visioncall

# Secret used to sign login sessions. Leave unset: a random one is created
# in DATA_DIR on first start and reused after that.
# JWT_SECRET=

# -----------------------------------------------------------------------------
# Calls (also editable from Settings)
# -----------------------------------------------------------------------------

# Most people in one group call. Default: 8
# MAX_CALL_PARTICIPANTS=8

# TURN relay, only needed when devices can't reach each other directly
# (some VPN meshes, several subnets, strict firewalls). TURN_SECRET must match
# the coturn static-auth-secret. See the wiki page "Networking and Firewall".
# TURN_HOST=192.168.1.50:3478
# TURN_SECRET=

# -----------------------------------------------------------------------------
# Files (also editable from Settings)
# -----------------------------------------------------------------------------

# Largest single upload in MB. Default: 50
# MAX_FILE_MB=50

# Upload space per user in MB, 0 for unlimited. Default: 2048
# MAX_USER_STORAGE_MB=2048

# Comma-separated file extensions to reject. Default: common executables and
# scripts. Set to "none" to allow every file type.
# BLOCKED_FILE_EXTENSIONS=.exe,.bat,.cmd,.ps1,.sh

# -----------------------------------------------------------------------------
# Sessions and logging (also editable from Settings)
# -----------------------------------------------------------------------------

# How long a device stays signed in without being used, in hours. The timer
# restarts every time the app is used, so regular users are never signed out.
# Default: 720 (30 days)
# SESSION_TTL_HOURS=720

# Permanently delete chat messages older than this many days (pinned messages
# are kept). 0 keeps everything. Default: 0
# MESSAGE_RETENTION_DAYS=0

# If set, /metrics requires "Authorization: Bearer <token>". If empty, /metrics
# only answers requests from the server itself and private networks.
# METRICS_TOKEN=

# debug, info, warn or error. Default: info
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Password reset by email (also editable from Settings)
# -----------------------------------------------------------------------------

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# PASSWORD_RESET_ENABLED=true

# The address people use to open the app, used to build links in emails and
# the single sign-on callback, e.g. https://visioncall.example.lan:8443
# PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Single sign-on with OpenID Connect (Keycloak, Authentik, Entra ID, ...)
# -----------------------------------------------------------------------------

# OIDC_ENABLED=true
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# OIDC_AUTO_CREATE_USERS=false
# OIDC_BUTTON_LABEL=Sign in with SSO
